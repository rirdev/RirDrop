{
  "name": "rirdrop",
  "productName": "RirDrop",
  "version": "1.0.0",
  "description": "Offline Local File Sharing & Media Streaming Suite",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/test-server.js && node tests/test-downloader.js && node tests/test-updates.js",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --win"
  },
  "keywords": [
    "file-sharing",
    "offline",
    "lan",
    "streaming",
    "video-stream",
    "cross-platform"
  ],
  "author": "RirDev <dev@rirdev.com>",
  "desktopName": "rirdrop.desktop",
  "license": "MIT",
  "dependencies": {
    "firebase": "^12.19.0",
    "mime-types": "^2.1.35",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rirdev.rirdrop",
    "productName": "RirDrop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/bin/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "RirDev <dev@rirdev.com>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RirDrop"
    }
  }
}
